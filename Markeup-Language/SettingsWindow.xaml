<Window
    x:Class="AppLibrary.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Settings">
    
    <Grid x:Name="SettingsRoot">
        <TabView IsAddTabButtonVisible="False">
            <TabViewItem Header="General" IsClosable="False">
                <StackPanel Padding="32" Spacing="24">
                    <!-- Text field max 18 characters -->
                    <TextBox x:Name="CustomTitleBox" Header="Custom Display Text" MaxLength="18" Width="300" HorizontalAlignment="Left" PlaceholderText="Enter up to 18 characters"/>
                    
                    <!-- Dark Mode toggle switch -->
                    <ToggleSwitch x:Name="DarkModeToggle" Header="OLED Dark Mode" OffContent="Disabled" OnContent="Enabled"/>
                    
                    <!-- Save Button -->
                    <Button Content="Save Changes" Background="Blue" Foreground="White" Width="150" Click="SettingsSave_Click"/>
                </StackPanel>
            </TabViewItem>
        </TabView>
    </Grid>
</Window>
